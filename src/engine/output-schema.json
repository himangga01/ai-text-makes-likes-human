{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["rewrittenText", "warnings"],
  "properties": {
    "rewrittenText": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
