{
  "name": "ai-text-makes-likes-human",
  "version": "0.5.0",
  "description": "한국어 윤문 · Claude/Codex CLI 스킬과 portable Windows 앱",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.desktop.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:live": "cross-env RUN_CODEX_LIVE=1 vitest run tests/integration/codex-live.test.ts",
    "test:performance": "cross-env RUN_CODEX_LIVE=1 vitest run tests/integration/performance-live.test.ts",
    "benchmark:speed": "node scripts/benchmark-speed.mjs",
    "desktop:dev": "node scripts/build-desktop.mjs && node scripts/run-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:portable": "node scripts/package-desktop.mjs",
    "skills:build": "node scripts/package-skills.mjs",
    "test:skills": "node scripts/python-tests.mjs tests/skills",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:documents": "node scripts/python-tests.mjs tests/documents"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himangga01/ai-text-makes-likes-human.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/himangga01/ai-text-makes-likes-human/issues"
  },
  "homepage": "https://github.com/himangga01/ai-text-makes-likes-human#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=24.19.0"
  }
}
